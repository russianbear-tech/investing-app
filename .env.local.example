# Copy this file to `.env.local` and paste your key in.
#
# This is the more private place to put your key: .env.local is git-ignored
# and, unlike the settings screen, the key never lands in the OneDrive-synced
# data file.
#
# Get one at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-your-key-here
